{
  "name": "color-lab-quality",
  "private": true,
  "version": "2.53.0",
  "type": "module",
  "scripts": {
    "test:verify": "node scripts/verify.mjs",
    "test:torture": "node scripts/torture.mjs",
    "test:property": "node scripts/property.mjs",
    "audit:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "test:lighthouse-summary": "node scripts/lighthouse-summary-test.mjs",
    "test:budget": "node scripts/budget.mjs",
    "test:visual": "node scripts/visual-audit.mjs",
    "test:e2e": "playwright test tests/e2e/color-lab.spec.js",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.js",
    "test:visual-regression": "playwright test tests/e2e/visual-regression.spec.js",
    "test:browser:core": "playwright test tests/e2e/color-lab.spec.js tests/e2e/accessibility.spec.js",
    "test:browser": "playwright test",
    "test:webkit:core": "playwright test --config=playwright.webkit.config.js",
    "build:native": "node scripts/build-native.mjs",
    "test:native": "node scripts/native-notices-test.mjs && node scripts/native-preflight.mjs",
    "test:app-icon": "node scripts/prepare-ios-assets.mjs --self-test",
    "ios:init": "npm run build:native && npx cap add ios && node scripts/patch-ios-project.mjs && node scripts/prepare-ios-assets.mjs",
    "ios:sync": "npm run build:native && npx cap sync ios && node scripts/patch-ios-project.mjs && node scripts/prepare-ios-assets.mjs",
    "ios:open": "npx cap open ios",
    "test:app-store-metadata": "node scripts/app-store-metadata-check.mjs --self-test && node scripts/app-store-metadata-check.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "fast-check": "4.10.2",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2"
  }
}
